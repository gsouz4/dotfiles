font-family = ZedMono Nerd Font Propo
font-size = 12.5
font-style = bold

theme = Ciapre

background-opacity=0.90

cursor-style = block
cursor-style-blink = false

# Logitech hi-res wheel on Wayland emits tiny "precision" scroll deltas that
# round down to zero rows with the default precision:1. Boost it so each notch moves.
mouse-scroll-multiplier = precision:3,discrete:3

window-padding-x = 10
window-padding-y = 4
window-decoration = none

command = /bin/zsh

keybind = shift+tab=toggle_maximize
keybind = ctrl+t=new_tab


