{
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "python3 ~/.claude/statusline.py"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "bedrock@claude-bedrock": true
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "claude-bedrock": {
      "source": {
        "source": "github",
        "repo": "iurykrieger/claude-bedrock"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "mcpServers": {
    "vela-mcp-hub": {
      "type": "http",
      "url": "https://karavela-core-backstage.stone.tech/api/mcp/gateway"
    }
  }
}
